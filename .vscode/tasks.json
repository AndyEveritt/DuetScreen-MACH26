{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"preset": "${command:cmake.activeConfigurePresetName}",
			"problemMatcher": [],
			"detail": "CMake template configure task",
			"group": "build",
		},
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"problemMatcher": [],
			"detail": "CMake template build task",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"CMake: configure",
				"Clang Format"
			]
		},
		{
			"type": "shell",
			"label": "Install npm dependencies",
			"command": "npm install",
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"type": "shell",
			"label": "Extract i18n phrases",
			"command": "./node_modules/.bin/lv_i18n extract -s 'src/**/*.+(c|cpp|h|hpp)' -t 'i18n/*.yml'",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"type": "shell",
			"label": "Compile i18n phrases",
			"command": "./node_modules/.bin/lv_i18n compile -t 'i18n/*.yml' -o 'src/lv_i18n'",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"runOptions": {
				"instanceLimit": 1
			},
			"dependsOn": [
				"Extract i18n phrases"
			]
		},
		{
			"type": "shell",
			"label": "Clang Format",
			"command": "find src/ -path 'src/lv_i18n' -prune -o -iname '*.h' -o -iname '*.cpp' -print | xargs clang-format -i",
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"label": "Build DuetScreen for Remote",
			"type": "shell",
			"command": "make duetscreen-rebuild",
			"args": [],
			"options": {
				"cwd": "${config:buildroot_path}",
				"env": {
					"DUETSCREEN_SRC": "${workspaceFolder}",
					"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Builds DuetScreen for remote debugging",
		},
		{
			"label": "Push DuetScreen - SSH",
			"type": "shell",
			"options": {
				"cwd": "${config:buildroot_path}"
			},
			"command": "command ssh root@${config:duetscreen_ip} 'start-stop-daemon -K -n DuetScreen';scp output/target/usr/bin/DuetScreen root@${config:duetscreen_ip}:/usr/bin/DuetScreen",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen binary to the screen and restart the service",
			"dependsOn": [
				"Build DuetScreen for Remote"
			],
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Push Assets - SSH",
			"type": "shell",
			"options": {
				"cwd": "${config:buildroot_path}"
			},
			"command": "command ssh root@${config:duetscreen_ip} 'mkdir -p /etc/assets'; scp assets/* root@${config:duetscreen_ip}:/etc/assets",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen assets to the screen",
			"dependsOn": [],
			"runOptions": {
				"instanceLimit": 1,
			}
		},
		{
			"label": "Push Libraries - SSH",
			"type": "shell",
			"options": {
				"cwd": "${config:buildroot_path}"
			},
			"command": "scp output/target/usr/lib/*lvgl* root@${config:duetscreen_ip}:/usr/lib",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen libraries to the screen",
			"dependsOn": [],
			"runOptions": {
				"instanceLimit": 1,
			}
		},
		{
			"label": "Start DuetScreen on remote",
			"type": "shell",
			"command": "command ssh root@${config:duetscreen_ip} '/etc/init.d/S20DuetScreen start'",
			"problemMatcher": [],
			"isBackground": true,
			// "dependsOn": [
			// 	"Push DuetScreen - SSH"
			// ],
		},
		{
			"label": "Start gdbserver on DuetScreen",
			"type": "shell",
			"command": "command ssh root@${config:duetscreen_ip} 'gdbserver :3000 DuetScreen'",
			"problemMatcher": [],
			"isBackground": true,
			// "dependsOn": [
			// 	"Push DuetScreen - SSH"
			// ],
		},
		{
			"label": "Upload config.json",
			"type": "shell",
			"command": "scp config.json root@${config:duetscreen_ip}:/etc/duetscreen.json",
			"problemMatcher": [],
		},
	]
}