{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "Debug",
            "hidden": true,
            "inherits": "Base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LOG_TIMESTAMPS": "ON",
                "LOG_THREAD": "ON",
                "DEBUG_BORDERS": "ON"
            }
        },
        {
            "name": "Release",
            "hidden": true,
            "inherits": "Base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LOG_TIMESTAMPS": "ON",
                "LOG_THREAD": "OFF"
            }
        },
        {
            "name": "Simulation",
            "displayName": "Simulation",
            "description": "Configure the project to be run locally on the host machine",
            "inherits": "Debug",
            "cacheVariables": {
                "PROCESSOR": "Simulation"
            }
        },
        {
            "name": "Simulation-Release",
            "displayName": "Simulation-Release",
            "description": "Configure the project to be run locally on the host machine",
            "inherits": "Release",
            "cacheVariables": {
                "PROCESSOR": "Simulation"
            }
        },
        {
            "name": "T113-Debug",
            "displayName": "T113 Debug",
            "description": "Configure the project to be run on T113 with debug symbols",
            "inherits": "Debug",
            "cacheVariables": {
                "PROCESSOR": "T113"
            }
        },
        {
            "name": "T113",
            "displayName": "T113 Release",
            "description": "Configure the project to be run on T113 without debug symbols",
            "inherits": "Release",
            "cacheVariables": {
                "PROCESSOR": "T113"
            }
        },
        {
            "name": "LVGL-Dev",
            "displayName": "LVGL Development",
            "description": "Development config for developing the LVGL library",
            "inherits": "Base",
            "cacheVariables": {
                "PROCESSOR": "Simulation",
                "LVGL_DEV": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "T113-Debug",
            "description": "",
            "displayName": "",
            "configurePreset": "T113-Debug"
        },
        {
            "name": "T113",
            "description": "",
            "displayName": "",
            "configurePreset": "T113"
        },
        {
            "name": "Simulation",
            "description": "",
            "displayName": "",
            "configurePreset": "Simulation"
        },
        {
            "name": "Simulation-Release",
            "description": "",
            "displayName": "",
            "configurePreset": "Simulation-Release"
        },
        {
            "name": "LVGL-Dev",
            "description": "",
            "displayName": "",
            "configurePreset": "LVGL-Dev"
        }
    ]
}